# Copy to .env (never commit .env).
# iPhone「Auth for Tesla」导出的 Refresh Token。
TESLA_REFRESH_TOKEN=

# 没有 token 时用内置样例数据验证栈：TESLA_MOCK=1
TESLA_MOCK=0

# 轮询间隔（秒）。过短会阻止车辆休眠。
TESLA_POLL_SECONDS=120

# 中国区账号改为 https://auth.tesla.cn/
TESLA_SSO_BASE_URL=https://auth.tesla.com/

TESLA_OWNER_API_BASE=https://owner-api.teslamotors.com/
HTTP_PORT=8080
TZ=Asia/Shanghai
